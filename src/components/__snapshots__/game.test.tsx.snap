        ><button type="button" disabled="" aria-label="Middle-right"></button
        ><button type="button" disabled="" aria-label="Bottom-left"></button
        ><button type="button" disabled="" aria-label="Bottom-center"></button
        ><button
          type="button"
          disabled=""
          aria-label="Bottom-right"
        ></button></section></main
