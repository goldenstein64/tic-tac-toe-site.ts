        id="lobby-status"
        data-status="waiting"
        >waiting</span
      ></footer
    ></body
  ></html
>
"
`;

exports[`game.tsx matches active lobby 1`] = `
"<html lang="en-US"
  ><head
    ><title>tic-tac-toe-site - Game</title
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1.0" /><script
