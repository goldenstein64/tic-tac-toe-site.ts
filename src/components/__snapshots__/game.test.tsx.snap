      href="/public/game.css" /></head
  ><body
    hx-trigger="load"
    hx-ext="sse"
    sse-connect="/api/game-move?id=2"
    sse-close="end"
    ><header
      ><nav id="top-nav"
        ><h1><a href="/">tic-tac-toe-site</a></h1
        ><div class="flex-fill"></div
